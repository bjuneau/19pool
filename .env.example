# Copy to .env.local for local overrides. Do NOT commit any values.
# Vercel: mirror the ones you want active in Project Settings → Environment
# Variables. Env changes require a redeploy to take effect.

# ─── Test mode ────────────────────────────────────────────────────────────────
# When set, ESPN fetches use this season year instead of the real current year.
# Historical data (2024/2025) lets us dry-run the mid-season UI before real
# 2026 games start in September. Leave unset in production.
# Example: 2025
VITE_TEST_SEASON=

# When VITE_TEST_SEASON is set, getCurrentNFLWeek() returns this pinned week
# regardless of the real date. Ignored when VITE_TEST_SEASON is unset.
# Example: 4
VITE_TEST_CURRENT_WEEK=
